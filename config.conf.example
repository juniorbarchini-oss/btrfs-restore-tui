# Btrfs Restore TUI - example configuration
# Copy to  ~/.config/restore-tui/config.conf   (or ~/.config/btrfs-restore/config.conf,
# or /etc/restore-tui/config.conf).  The program never rewrites or deletes this file.
#
# Every key can also be set as an environment variable with the RESTORE_TUI_ prefix
# (e.g. RESTORE_TUI_TARGET_DIR). Env wins over the file. The old BTRFS_REMOTE_* names
# still work but are deprecated.

# --- Backup target (USB drive / directory) --------------------------------
# Mount point of the drive to back up to. If unset, the tool auto-detects a
# writable removable drive under /run/media/<user>/ or /media/<user>/, preferring
# one that already holds a btrfs-restore backup, then one labelled USB_BTRFS.
# A "btrfs-restore/" folder is created inside whatever is chosen.
# For native btrfs send/receive the target must itself be a btrfs filesystem;
# otherwise snapshots are stored as compressed .btrfs.zst streams.
#TARGET_DIR=/run/media/hbarchini/USB_BTRFS

# --- Local snapshots -----------------------------------------------------
# Where read-only local snapshots of / and /home are created and looked for.
#LOCAL_SNAPSHOTS_DIR=/.snapshots
# Directory used to stage (btrfs receive) a remote/stream snapshot for browsing.
# Must be on a btrfs filesystem. Unset = the tool detects one.
#STAGING_DIR=/.snapshots/staging

# --- Retention ---------------------------------------------------------
# Snapshots share disk via btrfs CoW, so many incrementals cost little. After a
# successful backup the OLDEST completed snapshots are pruned until the drive is
# back under MAX_DISK_PERCENT usage.
MAX_DISK_PERCENT=80
# ...but never below this many snapshots (safety floor).
MIN_KEEP=2
# Optional extra hard cap on the snapshot count (0 = disabled).
#MAX_SNAPSHOTS=0

# --- Remote SSH target ------------------------------------------------
# Native btrfs replication over SSH. The remote user needs to be able to run
# `btrfs receive` on REMOTE_PATH (either it owns the dir, or a sudoers line:
#   <user> ALL=(root) NOPASSWD: /usr/bin/btrfs
#REMOTE_HOST=100.81.31.97
#REMOTE_PATH=/mnt/dellomar_backups
#REMOTE_USER=hbarchini
#REMOTE_PORT=22
#REMOTE_NAME=i7server
